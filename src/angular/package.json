    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "bootstrap": "^5.3.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.5.0",
    "eslint": "^10.12.0",
