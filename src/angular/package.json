    "@angular/router": "^22.1.5",
    "bootstrap": "^5.3.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.2.0",
    "eslint": "^10.9.1",
